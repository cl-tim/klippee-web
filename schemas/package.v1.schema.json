{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klippee.app/schemas/package.v1.json",
  "title": "Klippee Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "title",
    "visibility",
    "version",
    "printer",
    "files"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://klippee.app/schemas/package.v1.json"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,80}[a-z0-9]$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "unlisted", "private"]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "license": {
      "type": ["string", "null"],
      "maxLength": 80
    },
    "printer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model"],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "enclosure": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "board": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "extruder": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "hotend": {
          "type": ["string", "null"],
          "maxLength": 120
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "klipper": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "moonraker": {
          "type": ["string", "null"],
          "maxLength": 80
        },
        "ui": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "uniqueItems": true
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,40}[a-z0-9]$"
      },
      "uniqueItems": true
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "type", "required", "secret"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,80}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "device-path",
              "serial-id",
              "hostname",
              "ip-address",
              "url",
              "secret"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "default": {
            "type": ["string", "number", "boolean", "null"]
          },
          "example": {
            "type": ["string", "number", "boolean", "null"]
          },
          "pattern": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "public"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "not": {
              "pattern": "(^/|^[A-Za-z]:|\\.\\.)"
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "entrypoint",
              "macro",
              "include",
              "moonraker",
              "ui",
              "calibration",
              "state",
              "backup",
              "archive",
              "unknown"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "public": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["block", "warn", "info"]
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,80}[a-z0-9]$"
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
