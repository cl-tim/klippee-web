FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f

ARG OPENSCAD_VERSION=2026.04.05
ARG OPENSCAD_SHA256=b6c1a34965a846152b3a2fb9fa07e42f3a59b0f5d7f43fde7764bef4c54cd68a
ARG BOSL2_VERSION=v2.0.747
ARG BOSL2_SHA256=37f35570657f536658522dc6b29a77516ba3cb80314292a547cf0426d6785822

ENV DEBIAN_FRONTEND=noninteractive \
    BOSL2_VERSION=${BOSL2_VERSION} \
    OPENSCAD_VERSION=${OPENSCAD_VERSION} \
    OPENSCADPATH=/opt/openscad/libraries \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    QT_QPA_PLATFORM=offscreen \
    PORT=8080

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libgpg-error0 openscad \
    && curl --fail --location --silent --show-error \
      "https://files.openscad.org/snapshots/OpenSCAD-${OPENSCAD_VERSION}-x86_64.AppImage" \
      --output /tmp/openscad.AppImage \
    && echo "${OPENSCAD_SHA256}  /tmp/openscad.AppImage" | sha256sum --check --strict \
    && chmod +x /tmp/openscad.AppImage \
    && mkdir -p /opt/openscad \
    && cd /opt/openscad \
    && /tmp/openscad.AppImage --appimage-extract \
    && mv squashfs-root runtime \
    && printf '%s\n' '#!/bin/sh' 'exec /opt/openscad/runtime/AppRun "$@"' > /usr/local/bin/openscad \
    && chmod +x /usr/local/bin/openscad \
    && openscad --version 2>&1 | grep --fixed-strings "${OPENSCAD_VERSION}" \
    && curl --fail --location --silent --show-error \
      "https://github.com/BelfrySCAD/BOSL2/archive/refs/tags/${BOSL2_VERSION}.tar.gz" \
      --output /tmp/bosl2.tar.gz \
    && echo "${BOSL2_SHA256}  /tmp/bosl2.tar.gz" | sha256sum --check --strict \
    && mkdir -p "${OPENSCADPATH}/BOSL2" \
    && tar --extract --gzip --file /tmp/bosl2.tar.gz --strip-components=1 --directory "${OPENSCADPATH}/BOSL2" \
    && test -f "${OPENSCADPATH}/BOSL2/std.scad" \
    && printf '%s\n' 'include <BOSL2/std.scad>' 'cuboid([10, 10, 10]);' > /tmp/bosl2-smoke.scad \
    && openscad -o /tmp/bosl2-smoke.stl /tmp/bosl2-smoke.scad \
    && test -s /tmp/bosl2-smoke.stl \
    && rm /tmp/openscad.AppImage /tmp/bosl2.tar.gz /tmp/bosl2-smoke.scad /tmp/bosl2-smoke.stl \
    && apt-get purge -y --auto-remove curl \
    && useradd --create-home --uid 10001 cad \
    && rm -rf /var/lib/apt/lists/*

COPY server/cad-requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN python -c "import importlib.util; import build123d as b3d; assert importlib.util.find_spec('cadquery') is None; model = b3d.Box(10, 10, 10); assert b3d.export_stl(model, '/tmp/build123d-smoke.stl')" \
    && test -s /tmp/build123d-smoke.stl \
    && rm /tmp/build123d-smoke.stl

# The Gridfinity generators include their shared utility and constants files, so
# the whole set is staged in one directory for the smoke render.
COPY src/features/cadEditors/scad/gridfinity/*.scad /tmp/gridfinity/
COPY src/features/cadEditors/scad/opengrid/openGrid.scad /tmp/openGrid.scad
RUN openscad --enable textmetrics -o /tmp/gridfinity-bin.stl \
      -D 'gridx=1' -D 'gridy=1' -D 'gridz=3' -D 'gridz_define=0' \
      /tmp/gridfinity/gridfinity-rebuilt-bins.scad \
    && openscad --enable textmetrics -o /tmp/gridfinity-lite-bin.stl \
      -D 'gridx=1' -D 'gridy=1' -D 'gridz=3' -D 'gridz_define=0' \
      /tmp/gridfinity/gridfinity-rebuilt-lite.scad \
    && openscad --enable textmetrics -o /tmp/gridfinity-baseplate.stl \
      -D 'gridx=2' -D 'gridy=2' /tmp/gridfinity/gridfinity-rebuilt-baseplate.scad \
    && openscad --enable textmetrics -o /tmp/openGrid.stl \
      -D 'Board_Width=2' -D 'Board_Height=2' /tmp/openGrid.scad \
    && test -s /tmp/gridfinity-bin.stl \
    && test -s /tmp/gridfinity-lite-bin.stl \
    && test -s /tmp/gridfinity-baseplate.stl \
    && test -s /tmp/openGrid.stl \
    && rm -rf /tmp/gridfinity /tmp/openGrid.scad \
    && rm /tmp/gridfinity-bin.stl /tmp/gridfinity-lite-bin.stl /tmp/gridfinity-baseplate.stl \
      /tmp/openGrid.stl

COPY server ./server

USER cad

EXPOSE 8080

CMD ["sh", "-c", "exec python -m uvicorn server.cad_app:app --host 0.0.0.0 --port ${PORT}"]
