{
  "name": "klippee",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || 26.x"
  },
  "scripts": {
    "setup:dev": "npm install && node scripts/setup-dev.mjs",
    "dev": "vite",
    "build": "node scripts/build-orca-plugin.mjs && tsc -b && vite build",
    "build:cloudflare": "node scripts/configure-cloudflare.mjs && npm run build",
    "check": "npm run lint && npm run license:audit && npm run build && npm run test:cli && npm run test:orca && npm run test:ui && npm run test:web && node --test --test-concurrency=1 \"tests/worker/*.test.mjs\" && npm run test:self-host && npm run test:cad && npm run test:dev",
    "lint": "eslint .",
    "test:worker": "npm run build && node --test --test-concurrency=1 \"tests/worker/*.test.mjs\"",
    "test:cli": "node --test --test-concurrency=1 \"tests/cli/*.test.mjs\"",
    "test:ui": "node scripts/ui-qa.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "test:ui:smoke": "node scripts/ui-smoke.mjs",
    "test:ui:smoke:install": "playwright install chromium",
    "test:cad": "node scripts/python-env.mjs test-cad",
    "test:web": "vitest run --maxWorkers=1 --fileParallelism=false",
    "license:audit": "node scripts/license-audit.mjs",
    "dev:cad": "node scripts/python-env.mjs dev-cad",
    "docker:cad:build": "docker build -f Dockerfile.cad -t klippee-cad-engine .",
    "docker:cad:run": "docker run --rm -p 8791:8080 klippee-cad-engine",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "launch:verify": "node scripts/launch-verify.mjs",
    "predeploy": "node scripts/predeploy-check.mjs",
    "diagnostics:download-submissions": "node scripts/download-log-improvement-submissions.mjs",
    "storage:inventory": "node scripts/r2-inventory.mjs",
    "preview": "npm run build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "node scripts/ci-only.mjs && npm run db:migrate && wrangler deploy",
    "deploy:manual": "npm run predeploy && npm run build && npm run db:migrate && wrangler deploy",
    "test:orca": "node scripts/python-env.mjs test-orca",
    "start:self-host": "node scripts/self-host.mjs",
    "publication:check": "node scripts/publication-check.mjs",
    "test:self-host": "node --test --test-concurrency=1 \"tests/self-host/*.test.mjs\""
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.8.1",
    "@mantine/hooks": "^9.7.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "cn": "^0.5.2",
    "codemirror": "^6.0.2",
    "drizzle-orm": "0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.76.0",
    "miniflare": "5.20261019.2-beta",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwindcss": "^4.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.154.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
