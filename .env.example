# Required HTTPS URL of YOUR instance. Configure your reverse proxy for it.
APP_ORIGIN=https://klippee.example.com
# Generate with: openssl rand -hex 32. Keep this for printer sync tokens.
SESSION_SECRET=
# Use local for one shared workspace on a private network or behind access controls.
# Use oauth to require GitHub or Discord sign-in.
AUTH_MODE=local
# Only required with AUTH_MODE=oauth. Set at least one complete pair.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional operator-only API credentials. Leave blank to disable these APIs.
LOG_IMPROVEMENT_REVIEW_TOKEN=
STORAGE_MAINTENANCE_TOKEN=
# Release images are Linux AMD64 (the pinned OpenSCAD runtime is x86_64).
KLIPPEE_VERSION=selfhost-v0.1.4
# The published port is loopback-only for a host HTTPS reverse proxy.
KLIPPEE_BIND_ADDRESS=127.0.0.1
KLIPPEE_PORT=8080
